# Copy this to .env and put in your own string.

# Operating mode: demo or private.
#
#   demo    — the public showcase. The player runs Blender Foundation films
#             under Creative Commons; there are no external video sources.
#   private — the personal version. Video is taken from external sources,
#             which needs the dependencies from api/requirements-private.txt.
#
# Leave it at demo if you are not sure.
MODE=demo

# To generate: openssl rand -hex 32
SESSION_PEPPER=replace-this-with-a-long-random-string

# Secure cookies. 1 means the browser sends the session cookie only over
# https — which is how it should be on a real site behind a tunnel.
#
# Set it to 0 when trying the site locally over http://localhost:
# with 1 the browser will not keep the cookie at all, and signing in
# will look broken for no visible reason.
COOKIE_SECURE=1

# --- Letters about new episodes (optional) ---
# Not set — letters are simply not sent, and the site works as usual.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=robot@example.com
# SMTP_PASS=app-password
# SMTP_FROM=animeDik <robot@example.com>
# SITE_URL=https://anime.your-domain.com
