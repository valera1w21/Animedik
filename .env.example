# Скопируйте в .env и подставьте свою строку:
#     cp .env.example .env && chmod 600 .env && nano .env
# chmod 600 — читать файл сможет только владелец: внутри секреты.
# Каждая переменная отсюда доходит до контейнера только потому, что она
# перечислена в docker-compose.yml (раздел environment). Добавили сюда
# новую — её надо вписать и туда, иначе контейнер её не увидит.
# Этот файл читает ТОЛЬКО docker compose. Сайт, запущенный у себя без
# Docker (uvicorn), его не читает — там переменные задаются в окне
# терминала (PowerShell, bash) перед запуском.

# Режим работы: demo или private.
#
#   demo    — публичная витрина. Плеер играет фильмы Blender Foundation
#             под Creative Commons; внешних источников видео нет.
#   private — видео берётся с внешних источников, которые вы подключили
#             сами (api/anime.py, SOURCES). Пока их нет, ручки видео
#             честно отвечают 501 «Источники видео не подключены»;
#             каталог, полка, админка работают как обычно.
#
# Не задано — значит demo (так и в приложении, и в docker-compose.yml):
# забытая переменная поднимает безопасную витрину.
MODE=demo

# Сгенерировать: openssl rand -hex 32
# Сайт откажется запускаться (при COOKIE_SECURE=1), если строка осталась
# этой, из образца, или короче 16 знаков — так задумано.
# Сменили строку — закроются все сессии И перестанут подходить коды
# двухэтапного входа (2FA) у всех: каждому, у кого она была, снимите её
#     docker compose exec app python -m api.admin 2fa-off ЛОГИН
# и пусть включит заново в кабинете.
SESSION_PEPPER=замените-на-длинную-случайную-строку

# 1 — сайт открыт по https (через туннель). Так и должно стоять.
# Выключают только 0 (или false / no / off); любое другое значение сайт
# понимает как 1 — кука входа с пометкой Secure.
# 0 — только на время проверки по обычному http, иначе браузер не
# сохранит куку входа. После проверки верните 1.
# COOKIE_SECURE=1

# Подробность журнала: INFO обычно, DEBUG — при разборе неполадок.
# Регистр не важен; неизвестное слово — сайт возьмёт INFO и скажет об
# этом в журнале.
# LOG_LEVEL=INFO

# --- Письма о новых сериях (необязательно) ---
# Не заданы — письма просто не отправляются, сайт работает как обычно.
# Чтобы включить, уберите решётки и впишите свои значения. SMTP_FROM
# можно не задавать — тогда отправителем будет SMTP_USER.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=robot@example.com
# SMTP_PASS=пароль-приложения
# SMTP_FROM=анимеДик <robot@example.com>
# SITE_URL=https://anime.вашдомен.ру

# --- Помощник в пузыре «?» (необязательно) ---
# Чат-подсказчик: отвечает на вопросы, как пользоваться сайтом. Ключ не
# задан — помощник выключен, сайт работает как обычно.
#
# Как включить:
#   1. Зайдите на console.groq.com → API Keys → Create API Key
#      (бесплатно; ключ показывают один раз — сразу скопируйте).
#   2. Уберите решётку в строке HELPER_API_KEY и вставьте ключ после «=».
#   3. Перезапустите сайт: sudo docker compose up -d
#
# Ключ — секрет, как пароль: никому не показывайте и не выкладывайте.
# HELPER_API_KEY=
#
# Остальное трогать не нужно. Адрес и модель меняют, только если нужен
# другой провайдер с таким же API (OpenAI-совместимый), например Ollama:
#   HELPER_BASE_URL=http://адрес-ollama:11434/v1   HELPER_MODEL=qwen2.5:7b
# По умолчанию — Groq и модель llama-3.3-70b-versatile.
# HELPER_BASE_URL=https://api.groq.com/openai/v1
# HELPER_MODEL=llama-3.3-70b-versatile

# --- Свои источники и проверка новых серий (необязательно) ---
# Порядок английских источников через запятую (имена из anime.SOURCES);
# пусто — порядок из кода (anime.EN_DEFAULT_ORDER). Неизвестные имена
# отбрасываются. В публичной версии источников нет — оставьте пустым.
# EN_SOURCES=
#
# Раз во сколько минут сервер сам спрашивает источники о новых сериях
# (колокольчик и письма). 0 — не спрашивать вовсе.
# UPDATES_EVERY_MIN=15
