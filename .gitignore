# Settings with real values. Only .env.example belongs in the repository —
# .env holds SESSION_PEPPER and the mail password.
.env
.env.*
!.env.example
# Пароль шифрования копий, если вдруг положили рядом.
*.pass

# The database and its journal files. SQLite in WAL mode keeps part of the
# data in -wal and -shm, so a commit of the .db alone would be a corrupt
# copy anyway.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
data/

# Backups.
*.db.bak
*.db.part
*.db.enc
before-restore-*.tar
backups/

# Avatars and everything else people upload.
uploads/

# Python.
__pycache__/
*.pyc
.venv/
venv/

# Editors and operating systems.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Журналы прогона проверок.
журналы-проверок/
